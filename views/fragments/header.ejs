<header>
    <div id="titlu">
        <h1>GearLab<i class="fa-solid fa-gamepad"></i></h1>
        <div id="titlu-reflectat">Gearlab</div>
    </div>

    <script src="/resources/js/theme.js"></script>
    <script src="/resources/js/change_theme.js"></script>
    
    <nav>
        <label id="hamburger" for="ch-menu">
            <img src="resources/images/Hamburger_icon_alb.png" alt="Menu">
        </label>
        <input type="checkbox" , id="ch-menu">
        <ul class="menu">
            <li>
                <div class="text-nav">
                    <p>Acasa</p>
                </div>
                <div class="img-nav">
                    <i class="fa-solid fa-house"></i>
                </div>
                <ul>
                    <li><a href="/">Bine ati venit</a></li>
                    <li><a href="/#promotii">Promotii</a></li>
                    <li><a href="/#grid-logitech">GearLab & Logitech</a></li>
                </ul>
            </li>
            <li><a href="/despre">Despre noi</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><div>Produse</div>
                <ul>
                    <li><a href="/produse">Toate</a></li>
                    <% if (locals.optiuniMeniu) { %>
                        <% for(const opt of locals.optiuniMeniu) { %>
                            <li><a href="/produse?categorie=<%- opt.valoare %>"><%- opt.valoare %></a></li>
                        <% } %>
                    <% } %>
                </ul>
            </li>
        </ul>
    </nav>
    <div class="form-check form-switch position-absolute top-0 end-0 mt-3 me-3" style="z-index: 1000;">
        <input class="form-check-input" type="checkbox" role="switch" id="schimba_tema">
        <label class="form-check-label" for="schimba_tema">
            <i class="fa-solid fa-sun"></i> / <i class="fa-solid fa-moon"></i>
            Schimba tema
        </label>
    </div>
</header>