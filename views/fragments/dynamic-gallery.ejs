<section id="galery">
    <div class="dynamic-gallery">
        <% 
            function getRandomPictures(pictures) {
                const min = 6;
                const max = 12;
                const randomCount = Math.floor(Math.random() * (max - min + 1)) + min;
                const shuffled = [...pictures].sort(() => 0.5 - Math.random());
                return shuffled.slice(0, Math.min(randomCount, shuffled.length));
            }
            let selectedImages = getRandomPictures(locals.imagini || []);
            for (let imag of selectedImages) { 
        %>
            <figure class="gallery-item"><img src="<%- imag.fisier %>" alt="<%- imag.descriere || imag.titlu || imag.nume || 'Imagine Galerie' %>"></figure>
        <% } %>
    </div>
</section>