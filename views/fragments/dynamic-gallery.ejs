<section id="galery">
    <%
    const optiuniNrImagini = [6, 8, 10, 12];
    const nrImagini = optiuniNrImagini[Math.floor(Math.random() * optiuniNrImagini.length)];
    
    let galleryItems = [];
    if (typeof imagini !== 'undefined' && imagini.length > 0) {
        for (let i = 0; i < nrImagini; i++) {
            galleryItems.push(imagini[i % imagini.length]);
        }
    }
%>

<div class="dynamic-gallery-container">
    <div class="dynamic-gallery gallery-count-<%= nrImagini %>">
        <% galleryItems.forEach(function(img, idx) { %>
            <figure class="gallery-item">
                <img src="<%= img.fisier_mediu || img.fisier %>" alt="Imagine galerie <%= idx + 1 %>">
            </figure>
        <% }); %>
    </div>
</div>
</section>