<!DOCTYPE html>
<html  lang="ro">
    <head>
        <meta name="description" content="GearLab - Echipamente gaming de inalta performanta. Tastature mecanice, mouse, casti, mousepad-uri si controllere cu livrare in toata tara.">
        <meta name="keywords" content="gaming, peripherale, tastatura mecanica, mouse gaming, casti gaming, mousepad, controller,<%- locals.prod.nume %>">
        
        <title>GearLab - <%- locals.prod.nume %></title>
        <%- include("../fragments/head") %>     
        <link href="/resources/css/produs.css" type="text/css" rel="stylesheet" />
    </head>

        <%- include("../fragments/header") %>
    <main>
        <section>
            <h2>Detalii produs</h2>
                <article id="art-produs">
                    <h3><span class="nume"><%- locals.prod.nume %></span></h3>
                    <p>Preț: <span class="pret"><%- locals.prod.pret %> RON</span></p>
                    <p>Descriere: <span class="descriere"><%- locals.prod.descriere %> </span></p>
                    <p>Categorie: <span class="categorie"><%- locals.prod.categorie %> </span></p>
                    <p>Tip produs: <span class="tip_produs"><%- locals.prod.tip_produs %> </span></p>
                    <p>Masă: <span class="masa"><%- locals.prod.masa %> g</span></p>
                    <% if (locals.prod.materiale && locals.prod.materiale.length > 0) { %>
                        <p>Materiale: <span class="materiale"><%- locals.prod.materiale.join(', ') %> </span></p>
                    <% } %>
                    <p>Pentru gaming: <span class="pt_gaming"><%- locals.prod.pt_gaming ? 'Da' : 'Nu' %> </span></p>
                    <p>Data adăugare: <span class="data_adaugare"><%- new Date(locals.prod.data_adaugare).toLocaleDateString('ro-RO') %> </span></p>
                    <% if (locals.prod.imagine) { %>
                        <figure class="imag-produs">
                            <img  src="/resources/images/products/<%- locals.prod.imagine %>" alt="[imagine <%- locals.prod.nume %>]" />
                        </figure>
                    <% } %>
                </article>
            
        </section>
    </main>

    <%- include("../fragments/footer") %>
    </body>
</html>