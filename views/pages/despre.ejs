<!DOCTYPE html>
<html lang="ro">

<head>
    <title>GearLab</title>
    <meta name="description"
        content="Magazisnul GearLab ofera spre vanzare periferic de PC si laptop precum tastarua, mouse, casti si mousepad.">
    <meta name="keywords"
        content="PC, laptop, periferice, tastatura, wireless, mouse, mousepad, casti, set de casti, controller, Xbox, PS4, PS5, gaming, office">

    <%- include("../fragments/head.ejs") %>
    <link rel="stylesheet" href="/resources/css/despre.css" type="text/css" />
    <link rel="stylesheet" href="/resources/css/static-gallery.css" type="text/css" />
    <link rel="stylesheet" href="/resources/css/dynamic-gallery.css" type="text/css" />
    
</head>

<body>
    <%- include("../fragments/header.ejs") %>

        <main>
            <section id="zona-video">
                <video id="video-vtt" controls preload="auto" poster="./resources/images/video-poster.jpg">

                    <source src="./resources/video/gearlab-prezentare.mp4" type="video/mp4">
                    <source src="./resources/video/gearlab-prezentare.webm" type="video/webm">

                    <track src="./resources/vtt/gearlab-ro.vtt" kind="subtitles" srclang="ro" label="Română" default>
                    <track src="./resources/vtt/gearlab-en.vtt" kind="subtitles" srclang="en" label="English">

                    <p>Browserul tău nu suportă afișarea acestui video. Îl poți descărca de <a
                            href="./resources/video/gearlab-prezentare.mp4">aici</a>.</p>
                </video>
            </section>
            <hr>
            <%- include("../fragments/static-gallery.ejs") %>
        </main>
        <%- include("../fragments/footer.ejs") %>
</body>

</html>